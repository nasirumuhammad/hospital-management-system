# Copy to apps/api/.env for local development (never commit the real file).
# Every variable is validated at startup: apps/api/src/config/env.validation.ts

NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000

# PostgreSQL. `docker compose up -d postgres` listens on 5433 with these credentials.
DATABASE_URL=postgresql://healthcare_app:change_me@localhost:5433/healthcare_db
# true for managed databases reached over the public internet; false on a private network.
DATABASE_SSL=false

# At least 22 characters. Generate one with: openssl rand -base64 48
# Production refuses a value that still starts with "replace_with".
JWT_SECRET=replace_with_a_long_random_secret_generated_by_openssl
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Origin(s) of the web app, comma separated. Cookie-authenticated writes from any
# other origin are rejected (CSRF defence). WEB_URL is used in e-mailed links and
# must be https in production.
WEB_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# Session cookies. Leave COOKIE_DOMAIN unset unless web and API share a registrable
# domain. The web app proxies /api to the API, so cookies stay on the web origin.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
# Number of reverse-proxy hops in front of the API (affects rate limiting by IP).
# TRUST_PROXY=1

# First administrator, created on startup if no account has this e-mail.
# ADMIN_PASSWORD must be at least 12 characters. Remove both once you have signed in.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Mail, sent through Resend (https://resend.com). "console" prints links to the API log
# (development only); production requires "resend" and a verified sending domain.
MAIL_TRANSPORT=console
MAIL_FROM=CarePoint <no-reply@carepoint.local>
# RESEND_API_KEY=re_xxxxxxxx
REQUIRE_EMAIL_VERIFICATION=false

# ---- Web app (apps/web/.env.local) ----
# Development talks to the API directly:
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Production builds default to the same-origin /api proxy; set this at runtime on the
# web service instead (read by the Next server, never inlined into the browser bundle):
#   API_INTERNAL_URL=https://<your-api-host>/api
