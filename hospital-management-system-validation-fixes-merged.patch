diff --git a/apps/api/src/common/validators/date.decorators.spec.ts b/apps/api/src/common/validators/date.decorators.spec.ts
new file mode 100644
index 0000000..3499298
--- /dev/null
+++ b/apps/api/src/common/validators/date.decorators.spec.ts
@@ -0,0 +1,59 @@
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { CreatePatientDto } from '../../patients/dto/create-patient.dto';
+import { CreateInvoiceDto } from '../../invoices/dto/create-invoice.dto';
+import { CreateAppointmentDto } from '../../appointments/dto/create-appointment.dto';
+import { ListAppointmentsQueryDto } from '../../appointments/dto/list-appointments-query.dto';
+import { CreateDoctorDto } from '../../doctors/dto/create-doctor.dto';
+
+describe('strict input validation', () => {
+  const patient = (dateOfBirth: string) => plainToInstance(CreatePatientDto, {
+    firstName: 'Amina', lastName: 'Bello', email: 'amina@example.com', dateOfBirth,
+  });
+
+  it('rejects a date of birth in the future', async () => {
+    const tomorrow = new Date();
+    tomorrow.setDate(tomorrow.getDate() + 1);
+    const value = `${tomorrow.getFullYear()}-${String(tomorrow.getMonth() + 1).padStart(2, '0')}-${String(tomorrow.getDate()).padStart(2, '0')}`;
+    const errors = await validate(patient(value));
+    expect(errors.some((error) => error.property === 'dateOfBirth')).toBe(true);
+  });
+
+  it.each(['2025-02-29', '2024-13-01', '2024-04-31', 'tomorrow'])('rejects invalid calendar date %s', async (dateOfBirth) => {
+    const errors = await validate(patient(dateOfBirth));
+    expect(errors.some((error) => error.property === 'dateOfBirth')).toBe(true);
+  });
+
+  it('accepts a valid past date of birth', async () => {
+    const errors = await validate(patient('1998-07-14'));
+    expect(errors.some((error) => error.property === 'dateOfBirth')).toBe(false);
+  });
+
+  it.each(['2025-02-29', '2024-13-01', '2024-04-31'])('rejects invalid invoice due date %s', async (dueDate) => {
+    const dto = plainToInstance(CreateInvoiceDto, {
+      patientId: 'a2d4c5f0-5c3e-4a5d-9a2d-9a2c4d6f8a10', description: 'Consultation', amount: 100, dueDate,
+    });
+    const errors = await validate(dto);
+    expect(errors.some((error) => error.property === 'dueDate')).toBe(true);
+  });
+
+  it.each(['123', 'not a phone', '12345678901234567890'])('rejects malformed phone number %s', async (phone) => {
+    const dto = plainToInstance(CreateDoctorDto, { firstName: 'Amina', lastName: 'Bello', email: 'amina@example.com', specialty: 'General', phone });
+    const errors = await validate(dto);
+    expect(errors.some((error) => error.property === 'phone')).toBe(true);
+  });
+
+  it('rejects query date ranges where from is later than to', async () => {
+    const dto = plainToInstance(ListAppointmentsQueryDto, { from: '2026-10-22T12:00:00.000Z', to: '2026-10-21T12:00:00.000Z' });
+    const errors = await validate(dto);
+    expect(errors.some((error) => error.property === 'to')).toBe(true);
+  });
+
+  it('rejects appointment timestamps in the past', async () => {
+    const dto = plainToInstance(CreateAppointmentDto, {
+      doctorId: 'a2d4c5f0-5c3e-4a5d-9a2d-9a2c4d6f8a10', scheduledAt: '2020-01-01T10:00:00.000Z',
+    });
+    const errors = await validate(dto);
+    expect(errors.some((error) => error.property === 'scheduledAt')).toBe(true);
+  });
+});
diff --git a/apps/api/src/common/validators/date.decorators.ts b/apps/api/src/common/validators/date.decorators.ts
new file mode 100644
index 0000000..c376d4b
--- /dev/null
+++ b/apps/api/src/common/validators/date.decorators.ts
@@ -0,0 +1,79 @@
+import { registerDecorator, ValidationArguments, ValidationOptions } from 'class-validator';
+
+const DATE_ONLY = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+function parseDateOnly(value: unknown): Date | null {
+  if (typeof value !== 'string') return null;
+  const match = DATE_ONLY.exec(value);
+  if (!match) return null;
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return null;
+  return date;
+}
+
+export function IsValidDateOnly(options?: { notInFuture?: boolean }, validationOptions?: ValidationOptions): PropertyDecorator {
+  return (target, propertyName) => registerDecorator({
+    name: 'isValidDateOnly',
+    target: target.constructor,
+    propertyName: propertyName.toString(),
+    options: validationOptions,
+    validator: {
+      validate(value: unknown): boolean {
+        const parsed = parseDateOnly(value);
+        if (!parsed) return false;
+        if (!options?.notInFuture) return true;
+        const parts = new Intl.DateTimeFormat('en', { timeZone: 'Africa/Lagos', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
+        const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((item) => item.type === type)?.value ?? '';
+        const todayInNigeria = `${part('year')}-${part('month')}-${part('day')}`;
+        return typeof value === 'string' && value <= todayInNigeria;
+      },
+      defaultMessage(args: ValidationArguments): string {
+        if (options?.notInFuture) return `${args.property} must be a real date on or before today`;
+        return `${args.property} must be a real date in YYYY-MM-DD format`;
+      },
+    },
+  });
+}
+
+export function IsFutureDateTime(validationOptions?: ValidationOptions): PropertyDecorator {
+  return (target, propertyName) => registerDecorator({
+    name: 'isFutureDateTime',
+    target: target.constructor,
+    propertyName: propertyName.toString(),
+    options: validationOptions,
+    validator: {
+      validate(value: unknown): boolean {
+        if (typeof value !== 'string' || value.trim() === '') return false;
+        const timestamp = Date.parse(value);
+        return Number.isFinite(timestamp) && timestamp > Date.now();
+      },
+      defaultMessage(args: ValidationArguments): string {
+        return `${args.property} must be a valid date and time in the future`;
+      },
+    },
+  });
+}
+
+export function IsDateRangeEnd(validationOptions?: ValidationOptions): PropertyDecorator {
+  return (target, propertyName) => registerDecorator({
+    name: 'isDateRangeEnd',
+    target: target.constructor,
+    propertyName: propertyName.toString(),
+    options: validationOptions,
+    validator: {
+      validate(value: unknown, args: ValidationArguments): boolean {
+        const from = (args.object as Record<string, unknown>).from;
+        if (from === undefined || from === null || from === '' || value === undefined || value === null || value === '') return true;
+        const fromTime = Date.parse(String(from));
+        const toTime = Date.parse(String(value));
+        return Number.isFinite(fromTime) && Number.isFinite(toTime) && fromTime <= toTime;
+      },
+      defaultMessage(args: ValidationArguments): string {
+        return `${args.property} must be on or after from`;
+      },
+    },
+  });
+}
diff --git a/apps/api/src/common/validators/phone.decorator.ts b/apps/api/src/common/validators/phone.decorator.ts
new file mode 100644
index 0000000..a28c35d
--- /dev/null
+++ b/apps/api/src/common/validators/phone.decorator.ts
@@ -0,0 +1,14 @@
+import { applyDecorators } from '@nestjs/common';
+import { IsString, MaxLength, Matches } from 'class-validator';
+import { Trimmed } from './trimmed.decorator';
+
+// Accept common local and international phone formatting without accepting letters or short values.
+export function IsPhoneLike() {
+  return applyDecorators(
+    Trimmed(),
+    IsString(),
+    MaxLength(30),
+    Matches(/^\+?[0-9](?:[0-9\s().-]*[0-9])?$/, { message: 'phone must contain only digits and common phone separators' }),
+    Matches(/^(?=(?:\D*\d){7,15}\D*$).+$/, { message: 'phone must contain between 7 and 15 digits' }),
+  );
+}
