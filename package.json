{
  "name": "healthcare-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter @healthcare/api --filter @healthcare/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @healthcare/api test",
    "test:e2e": "pnpm --filter @healthcare/api test:e2e",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "dev:api": "pnpm --filter @healthcare/api start:dev",
    "dev:web": "pnpm --filter @healthcare/web dev"
  },
  "devDependencies": { "typescript": "^5.8.3" },
  "pnpm": { "onlyBuiltDependencies": ["bcrypt"] }
}
