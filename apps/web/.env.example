# Frontend (Next.js). Copy to apps/web/.env.local for local development:
#   cp .env.example .env.local
# Never commit the real file.

# Development: the browser calls the API directly (same site on localhost, so cookies work).
# This value is inlined into the browser bundle at BUILD time, so changing it needs a rebuild.
# Production builds default to "/api" (the same-origin proxy route) when it is unset; leave
# it unset there rather than baking a URL into the bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-side URL the Next server uses to reach the API (Server Components and the /api
# proxy route), including the /api prefix. Read at RUNTIME, never exposed to the browser.
# Optional in development (defaults to http://localhost:4000/api); required in production,
# e.g. https://<your-api-host>/api
API_INTERNAL_URL=http://localhost:4000/api
